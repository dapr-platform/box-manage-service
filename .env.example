# =============================================================================
# box-manage-service 环境变量配置模板
# 复制本文件为 .env 并按实际部署环境修改
#   cp .env.example .env
# =============================================================================


# =============================================================================
# 一、应用基础配置
# =============================================================================
# 应用名称（仅日志展示用）
APP_NAME=box-manage-service
# 应用版本
APP_VERSION=1.0.0
# 运行环境：dev / test / prod
APP_ENV=dev
# 调试模式（生产环境建议 false）
APP_DEBUG=true
# 是否自动执行数据库迁移（生产环境首次可 true，稳定后可 false）
DB_AUTO_MIGRATE=true
# 启动时是否重置内置节点模板数据（执行 node_template_init_data.sql 重新灌入）
RESET_NODE_TEMPLATE_DATA=true


# =============================================================================
# 二、数据库配置（PostgreSQL）
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=box_manage
# 禁用 SSL / require / verify-full
DB_SSLMODE=disable
# 数据库时区
DB_TIMEZONE=Asia/Shanghai
# 连接池最大空闲连接数
DB_MAX_IDLE_CONNS=10
# 连接池最大打开连接数
DB_MAX_OPEN_CONNS=100
# 连接最大存活时间（示例 1h）
DB_MAX_LIFETIME=1h
# 数据库日志级别：silent / error / warn / info
DB_LOG_LEVEL=warn
# 慢 SQL 阈值（示例 200ms）
DB_SLOW_THRESHOLD=200ms


# =============================================================================
# 三、HTTP 服务器配置
# =============================================================================
# 监听地址
SERVER_HOST=0.0.0.0
# 监听端口（可被 LISTEN_PORT 覆盖）
SERVER_PORT=80
# 读取超时
SERVER_READ_TIMEOUT=30s
# 写入超时
SERVER_WRITE_TIMEOUT=30s
# 空闲超时
SERVER_IDLE_TIMEOUT=120s
# CORS 允许来源（逗号分隔，* 表示全部）
SERVER_ALLOWED_ORIGINS=*
# CORS 允许方法
SERVER_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS 允许请求头
SERVER_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token


# =============================================================================
# 四、Swagger 与路由前缀
# =============================================================================
# 是否启用 Swagger 文档
SWAGGER_ENABLED=true
# Swagger 是否启用基础鉴权
SWAGGER_AUTH_ENABLED=true
# Swagger 基础鉴权用户名
SWAGGER_AUTH_USER=admin
# Swagger 基础鉴权密码
SWAGGER_AUTH_PASS=swagger2024
# 路由基础前缀（所有接口路径前缀，示例 /api/box-manage-service）
BASE_CONTEXT=
# Swagger BasePath（通常与 BASE_CONTEXT 保持一致）
SWAGGER_BASE_PATH=/
# 覆盖监听端口（优先级高于 SERVER_PORT）
LISTEN_PORT=


# =============================================================================
# 五、模型存储与上传配置
# =============================================================================
# 模型存储基础路径
MODEL_STORAGE_BASE_PATH=./data/models
# 上传临时路径
MODEL_TEMP_PATH=./temp/uploads
# 单个文件最大大小（字节，默认 10GB = 10737418240）
MODEL_MAX_FILE_SIZE=10737418240
# 分片上传块大小（字节，默认 5MB = 5242880）
MODEL_CHUNK_SIZE=5242880
# 上传会话超时时间
MODEL_SESSION_TIMEOUT=24h
# 最大并发上传数
MODEL_MAX_CONCURRENT_UPLOADS=10
# 允许的模型文件类型（逗号分隔）
MODEL_ALLOWED_TYPES=.pt,.onnx
# 是否启用校验和验证
MODEL_ENABLE_CHECKSUM=true
# 是否启用压缩
MODEL_ENABLE_COMPRESSION=false
# 是否启用病毒扫描
MODEL_ENABLE_VIRUS_SCAN=false
# 热存储阈值（字节，默认 100MB）
MODEL_HOT_STORAGE_THRESHOLD=104857600
# 温存储阈值（字节，默认 1GB）
MODEL_WARM_STORAGE_THRESHOLD=1073741824
# 清理任务执行间隔
MODEL_CLEANUP_INTERVAL=1h
# 上传会话保留天数
MODEL_SESSION_RETENTION_DAYS=7
# 临时文件保留小时数
MODEL_TEMP_FILE_RETENTION_HOURS=24


# =============================================================================
# 六、模型转换服务配置（对接 yolo-converter）
# =============================================================================
# 转换失败最大重试次数
CONVERSION_MAX_RETRIES=3
# 转换任务保留时间
CONVERSION_TASK_RETENTION_TIME=7d
# 失败任务保留时间
CONVERSION_FAILED_TASK_RETENTION_TIME=3d
# 最大并发转换任务数
CONVERSION_MAX_CONCURRENT_TASKS=3
# 转换日志目录
CONVERSION_LOG_PATH=./data/logs/conversion
# 转换输出目录
CONVERSION_OUTPUT_PATH=./data/models/converted
# 转换服务 URL（yolo-converter / trans_go）
CONVERSION_URL=http://yolo-converter-go:9000
# CPU 限制（核心数）
CONVERSION_CPU_LIMIT=2
# 内存限制（MB）
CONVERSION_MEMORY_LIMIT=4096
# GPU 限制（数量）
CONVERSION_GPU_LIMIT=1
# 队列缓冲区大小
CONVERSION_QUEUE_BUFFER=100
# 工作节点数量
CONVERSION_WORKER_COUNT=2
# 健康检查间隔
CONVERSION_HEALTH_CHECK_INTERVAL=30s


# =============================================================================
# 七、SmartVision 平台对接配置
# =============================================================================
# SmartVision 平台地址
SMARTVISION_BASE_URL=http://10.188.26.81:8081/Smart-Vision
# 对接账号
SMARTVISION_USERNAME=taike
# 对接密码
SMARTVISION_PASSWORD=
# 客户端名称
SMARTVISION_CLIENT_NAME=TAIKE
# 客户端 ID
SMARTVISION_CLIENT_ID=
# 部署客户端 IP（可选）
SMARTVISION_DEPLOY_CLIENT_IP=
# 请求超时
SMARTVISION_TIMEOUT=15s
# 同步用户的默认明文密码
SMARTVISION_DEFAULT_SYNC_PASSWORD=tk@2026
# 同步用户的默认角色
SMARTVISION_DEFAULT_SYNC_ROLE=user
# 是否启用用户同步
SMARTVISION_ENABLE_USER_SYNC=true
# 用户同步间隔
SMARTVISION_USER_SYNC_INTERVAL=30m
# 是否启用模型同步
SMARTVISION_ENABLE_MODEL_SYNC=true
# 模型同步间隔
SMARTVISION_MODEL_SYNC_INTERVAL=60m
# 启动时是否立即同步
SMARTVISION_SYNC_ON_START=false


# =============================================================================
# 八、视频管理配置（ZLMediaKit + FFmpeg）
# =============================================================================
# ZLMediaKit 服务地址
VIDEO_ZLMEDIAKIT_HOST=zlmediakit
# ZLMediaKit 端口
VIDEO_ZLMEDIAKIT_PORT=80
# ZLMediaKit API 密钥
VIDEO_ZLMEDIAKIT_SECRET=
# ZLMediaKit 请求超时（秒）
VIDEO_ZLMEDIAKIT_TIMEOUT=30
# 默认应用名
VIDEO_ZLMEDIAKIT_DEFAULT_APP=live
# 默认虚拟主机
VIDEO_ZLMEDIAKIT_DEFAULT_VHOST=__defaultVhost__
# RTSP 访问前缀
VIDEO_ZLMEDIAKIT_RTSP_PREFIX=rtsp://zlmediakit:554
# FFmpeg 可执行文件路径
VIDEO_FFMPEG_PATH=/usr/bin/ffmpeg
# FFprobe 可执行文件路径
VIDEO_FFPROBE_PATH=/usr/bin/ffprobe
# FFmpeg 处理超时（秒）
VIDEO_FFMPEG_TIMEOUT=300
# FFmpeg 默认质量参数
VIDEO_FFMPEG_QUALITY=23
# FFmpeg 并发处理数量
VIDEO_FFMPEG_WORKER_COUNT=2
# 视频存储基础路径
VIDEO_STORAGE_BASE_PATH=./data/video
# 抽帧图片存储路径
VIDEO_STORAGE_FRAME_PATH=./data/video/frames
# 录制文件存储路径
VIDEO_STORAGE_RECORD_PATH=./data/video/records
# 视频临时路径
VIDEO_STORAGE_TEMP_PATH=./data/video/temp
# 转换后文件路径
VIDEO_STORAGE_CONVERTED_PATH=./data/video/converted
# 抽帧默认帧数
VIDEO_EXTRACT_DEFAULT_FRAME_COUNT=10
# 抽帧默认图片质量
VIDEO_EXTRACT_DEFAULT_QUALITY=2
# 抽帧最大帧数限制
VIDEO_EXTRACT_MAX_FRAME_COUNT=1000
# 抽帧默认图片格式
VIDEO_EXTRACT_DEFAULT_FORMAT=jpg
# 录制默认时长（秒）
VIDEO_RECORD_DEFAULT_DURATION=60
# 录制最大时长（秒）
VIDEO_RECORD_MAX_DURATION=3600
# 录制默认格式
VIDEO_RECORD_DEFAULT_FORMAT=mp4
# 录制默认编码
VIDEO_RECORD_DEFAULT_CODEC=h264
# 流播放 URL 前缀
VIDEO_PLAY_URL_STREAM_PREFIX=/stream/live
# 文件播放 URL 前缀
VIDEO_PLAY_URL_FILE_PREFIX=/stream/record/videos/converted
# 播放路由前缀（录制时需去除）
VIDEO_PLAY_URL_ROUTE_PREFIX=/stream


# =============================================================================
# 九、日志配置
# =============================================================================
# 日志级别：debug / info / warn / error
LOG_LEVEL=info
# 日志格式：json / text
LOG_FORMAT=json
# 日志输出目标：stdout / file
LOG_OUTPUT=stdout
# 日志文件路径（LOG_OUTPUT=file 时生效）
LOG_FILE_PATH=./logs/app.log
# 单个日志文件最大大小（MB）
LOG_MAX_SIZE=100
# 最大备份文件数
LOG_MAX_BACKUPS=3
# 日志最大保留天数
LOG_MAX_AGE=7
